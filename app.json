{
  "expo": {
    "name": "Family Score Keeper",
    "slug": "family-score-keeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bartekw.familyscorekeeper",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bartekw.familyscorekeeper",
      "permissions": []
    },
    "scheme": "familyscorekeeper",
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Family Score Keeper does not read your photo library.",
          "cameraPermission": "Family Score Keeper uses the camera so you can take a selfie that shows your family who you are.",
          "microphonePermission": false
        }
      ]
    ],
    "backgroundColor": "#F4F1EA",
    "extra": {
      "router": {}
    },
    "owner": "bartnotsimpson"
  }
}
