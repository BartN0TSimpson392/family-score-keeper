{
  "expo": {
    "name": "Family Score Keeper",
    "slug": "family-score-keeper",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.bartekw.familyscorekeeper",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.bartekw.familyscorekeeper",
      "permissions": [],
      "adaptiveIcon": {
        "backgroundColor": "#1F2A44",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "scheme": "familyscorekeeper",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 260,
          "backgroundColor": "#1F2A44"
        }
      ],
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Family Score Keeper does not read your photo library.",
          "cameraPermission": "Family Score Keeper uses the camera so you can take a selfie that shows your family who you are.",
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ]
    ],
    "backgroundColor": "#1F2A44",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "887ee359-dbd8-4da7-be13-3a4c7bd03104"
      }
    },
    "owner": "bartnotsimpson",
    "icon": "./assets/icon.png"
  }
}
